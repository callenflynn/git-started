{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "git-started",
  "version": "0.1.0",
  "identifier": "com.gitstarted.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "git-started",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "template": null
      },
      "nsis": {
        "installerHooks": null
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Notsk/git-started/releases/latest/download/updates.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzMDcwNzEyRTNGREI2RTAKU1dUZ3R2M2pFZ2NIZ3hKcXl2eTYxWUowMzFtTVByUTAxOFBPL2pNVUJ4QVFsZmsrU05SNzhHUmEK"
    }
  }
}
